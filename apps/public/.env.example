# Supabase — solo lectura de public.public_results con la clave anon/publishable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 'true' para usar lib/mockPublicData.ts en lugar de Supabase (desarrollo sin backend).
NEXT_PUBLIC_USE_MOCKS=false

# Solo servidor: verifica la firma del webhook de revalidación. Debe ser igual al
# REVALIDATE_SECRET del backend. Nunca con prefijo NEXT_PUBLIC_.
REVALIDATE_SECRET=
