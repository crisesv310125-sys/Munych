// Worker de la página pública de resultados (Next.js con OpenNext).
// Antes del primer deploy hay que crear los recursos en la cuenta de Cloudflare de Munych:
//   npx wrangler r2 bucket create munych-public-cache
//   npx wrangler d1 create munych-public-tags      → copia el database_id aquí abajo
//   npx wrangler secret put REVALIDATE_SECRET       → el mismo valor que en el backend
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "munych-public",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
