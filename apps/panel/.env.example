# Base de la API del backend (incluye /api/v1). Ver routes.md.
# Sin esta variable, el cliente usa '/api/v1' relativo (mismo origen que el panel).
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Supabase — solo para autenticación (clave anon/publishable; nunca la service_role aquí).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 'true' para trabajar sin backend: MSW intercepta /api/v1/* y la sesión se simula (solo en dev).
# Por defecto (sin la variable o con cualquier otro valor) se habla con el backend real.
VITE_USE_MOCKS=false
